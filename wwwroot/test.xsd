    <xs:sequence>
      <xs:element name="nimi" type="xs:string"/>
      <xs:element name="lapsed" type="lapsedTyyp" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="synd" type="xs:gYear" use="required"/>
